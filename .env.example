# Copy this file to .env and fill in your own details.
# .env is git-ignored and must never be committed or shared.

# Your dbonline.co.za login
DATABUILD_USERNAME=you@example.com
DATABUILD_PASSWORD=your-password

# Optional: output folder for the project files.
# Leave empty to use C:\Users\<you>\OneDrive\Databuild (or ~/Databuild if no OneDrive).
# Example: DATABUILD_OUTPUT_DIR=C:\Users\you\OneDrive\Databuild
DATABUILD_OUTPUT_DIR=